# Flash Sale — Docker compose env (template)
# Copy this file to .env and adjust for your environment:
#   cp .env.example .env
#
# This file is loaded by:
#   1. docker compose itself for ${VAR} interpolation (postgres credentials,
#      image version pins, etc.)
#   2. NestJS containers via env_file: directive (runtime config)
#
# IMPORTANT — POSTGRES_PASSWORD must match between this file and the
# postgres service inside docker-compose.yml. They're the same value, so
# the comment is just a reminder: if you rotate one, check both.

# ─── Image versions (used by compose for ${VAR} interpolation) ──────────────
PG_VERSION=16
REDIS_VERSION=7-alpine
NGINX_VERSION=1.27-alpine

# ─── PostgreSQL credentials (used by compose AND by nest containers) ───────
POSTGRES_USER=app
POSTGRES_PASSWORD=changeme
POSTGRES_DB=flashsale
POSTGRES_REPLICATION_USER=repl
POSTGRES_REPLICATION_PASSWORD=changeme
POSTGRES_MAX_CONNECTIONS=1500

# ─── NestJS runtime config (loaded into nest containers) ──────────────────────
NODE_ENV=production
PORT=3000
ADMIN_PORT=3001
LOG_LEVEL=warn

# Docker network hostnames for nest containers
POSTGRES_PRIMARY_HOST=postgres-primary
POSTGRES_PRIMARY_PORT=5432
POSTGRES_REPLICA_HOST=postgres-replica
POSTGRES_REPLICA_PORT=5432
REDIS_HOST=redis
REDIS_PORT=6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-32-byte-random-string
JWT_EXPIRES_IN=1h
