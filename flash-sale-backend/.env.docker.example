# Flash Sale — Docker compose env (template)
# Copy this file to .env.docker and edit if needed:
#   cp flash-sale-backend/.env.docker.example flash-sale-backend/.env.docker
#
# IMPORTANT — POSTGRES_PASSWORD MUST match POSTGRESQL_PASSWORD
# in docker-compose.yml (postgres-primary service). If you change
# one, change the other too — otherwise nest auth fails.

NODE_ENV=production
PORT=3000
ADMIN_PORT=3001
LOG_LEVEL=warn


POSTGRES_PRIMARY_HOST=postgres-primary
POSTGRES_PRIMARY_PORT=5432
POSTGRES_REPLICA_HOST=postgres-replica
POSTGRES_REPLICA_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=app123
POSTGRES_DB=flashsale

REDIS_HOST=redis
REDIS_PORT=6379

# Replace this with a long random string in production
JWT_SECRET=flash-sale-jwt-secret-change-me
JWT_EXPIRES_IN=1h